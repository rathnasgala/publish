{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gala.dev/contracts/reconciliation-envelope.schema.json",
  "title": "Gala reconciliation envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commitSha",
    "deploymentCommitSha",
    "runId",
    "runAttempt",
    "emittedAt",
    "runStatus",
    "daysSinceLastCommit",
    "themePackage",
    "articles"
  ],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "deploymentCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": { "type": "integer", "minimum": 1 },
    "runAttempt": { "type": "integer", "minimum": 1 },
    "emittedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "runStatus": { "enum": ["SUCCESS", "FAILED"] },
    "daysSinceLastCommit": { "type": "integer", "minimum": 0 },
    "themePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@rathnasgala/theme" },
        "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicViewCounts"],
      "properties": {
        "publicViewCounts": { "type": "boolean" }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "websiteEnabled", "phoneEnabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "websiteEnabled": { "type": "boolean" },
        "phoneEnabled": { "type": "boolean" }
      }
    },
    "floorGuardOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousPageCount", "currentPageCount", "lostPages", "reason"],
      "properties": {
        "previousPageCount": { "type": "integer", "minimum": 1 },
        "currentPageCount": { "type": "integer", "minimum": 0 },
        "lostPages": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "prism": { "$ref": "#/$defs/prismSettings" },
    "articles": {
      "type": "array",
      "items": { "$ref": "#/$defs/article" }
    }
  },
  "allOf": [{
    "if": { "properties": { "schemaVersion": { "const": 2 } }, "required": ["schemaVersion"] },
    "then": {
      "required": ["prism"],
      "properties": {
        "prism": { "$ref": "#/$defs/prismSettings" },
        "articles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "prismSourceHash": true,
                    "prismHashContract": true,
                    "prismProtectionContract": true,
                    "prismReferencedMediaDigests": true
                  },
                  "required": [
                    "prismSourceHash",
                    "prismHashContract",
                    "prismProtectionContract",
                    "prismReferencedMediaDigests"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "else": {
      "allOf": [
        { "not": { "required": ["prism"] } },
        {
          "properties": {
            "articles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "variants": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": { "configurations": { "type": "array" } },
                      "not": {
                        "properties": { "configurations": { "type": "array" } },
                        "required": ["configurations"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }],
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "variants"],
      "properties": {
        "id": { "$ref": "#/$defs/ulid" },
        "slug": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "state",
        "contentHash",
        "title",
        "tags",
        "canonicalUrl",
        "frontmatter"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "state": { "enum": ["PUBLISHED", "TOMBSTONED"] },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1 }
        },
        "coverImage": { "type": ["string", "null"] },
        "canonicalUrl": {
          "type": "string",
          "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?::[0-9]{1,5})?(?:/[^\\s]*)?$"
        },
        "frontmatter": { "type": "object", "additionalProperties": true },
        "markdownBody": { "type": ["string", "null"], "maxLength": 1000000 },
        "prismSourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "prismHashContract": { "const": "GALA_PRISM_HASH_V1" },
        "prismProtectionContract": { "$ref": "#/$defs/prismProtectionContract" },
        "prismReferencedMediaDigests": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "configurations": {
          "type": "array",
          "items": { "$ref": "#/$defs/prismConfiguration" }
        }
      },
      "allOf": [{
        "if": { "properties": { "state": { "const": "PUBLISHED" } }, "required": ["state"] },
        "then": {
          "properties": {
            "frontmatter": {
              "type": "object",
              "required": ["publishAfterDate"],
              "properties": {
                "publishAfterDate": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
                }
              }
            }
          }
        }
      }]
    },
    "prismSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "configurationLinkPolicy", "articleModes", "articleConfigurationLinkPolicies"],
      "properties": {
        "mode": { "enum": ["OFF", "PRESENTATION_ONLY", "MANUAL", "ASSISTED"] },
        "configurationLinkPolicy": { "enum": ["NOFOLLOW", "FOLLOW"] },
        "articleModes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/ulid" },
          "additionalProperties": { "enum": ["OFF", "PRESENTATION_ONLY", "MANUAL", "ASSISTED"] }
        },
        "articleConfigurationLinkPolicies": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/ulid" },
          "additionalProperties": { "enum": ["NOFOLLOW", "FOLLOW"] }
        }
      }
    },
    "prismProtectionContract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion"],
          "properties": {
            "schemaVersion": { "const": 1 },
            "caveats": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "names": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "attributions": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "prismConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revisionId", "approvalId", "approvalTokenVersion", "approvalTokenVerifiedWith", "hashContract", "state", "sourceRevisionHash", "contentHash", "depth", "intent", "modality", "configurationLinkPolicy", "pageUrl"],
      "properties": {
        "id": { "$ref": "#/$defs/ulid" },
        "revisionId": { "$ref": "#/$defs/ulid" },
        "approvalId": { "$ref": "#/$defs/ulid" },
        "approvalTokenVersion": { "const": 1 },
        "approvalTokenVerifiedWith": { "enum": ["CURRENT", "PREVIOUS"] },
        "hashContract": { "const": "GALA_PRISM_HASH_V1" },
        "state": { "enum": ["PUBLISHED", "STALE", "DISABLED", "REVOKED"] },
        "sourceRevisionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "depth": { "enum": ["SIGNAL", "BRIEF", "STANDARD", "COMPLETE", "METHODS_REFERENCES"] },
        "intent": { "enum": ["ORIENTATION", "STORY", "PROOF", "PRACTICE"] },
        "modality": { "const": "TEXT" },
        "configurationLinkPolicy": { "enum": ["NOFOLLOW", "FOLLOW"] },
        "pageUrl": { "type": "string", "pattern": "^https://[^\\s]+$" }
      }
    }
  }
}
